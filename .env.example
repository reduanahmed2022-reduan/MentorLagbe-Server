# MONGODB_URI and JWT_SECRET are boot-blocking. MONGODB_URI, JWT_SECRET and
# BETTER_AUTH_SECRET (below) are checked by scripts/verify-env.mjs preflight.
MONGODB_URI=your_mongodb_atlas_connection_string
JWT_SECRET=replace_with_a_long_random_secret

# BetterAuth (server-only — never set these in the Vercel/client project).
# BETTER_AUTH_SECRET is required by preflight and to mount /api/better-auth.
# BETTER_AUTH_URL is the API origin (not the client origin); the client derives
# the endpoint as ${NEXT_PUBLIC_API_URL}/better-auth.
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth (server-only — never add NEXT_PUBLIC_GOOGLE_* to the client).
# Leave both blank to disable Google sign-in; /api/auth/google/status reports enabled=false.
# Google Console authorized redirect URI:
#   ${BETTER_AUTH_URL}/api/better-auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional (defaults shown): PORT falls back to 5000, JWT_EXPIRES_IN to 7d.
PORT=5000
JWT_EXPIRES_IN=7d
# Set to production in deployment (platform-provided where applicable).
NODE_ENV=development

# CLIENT_URL may be comma-separated for CORS; Stripe redirects use the first
# non-localhost origin in production (first entry locally).
# Optional in code (defaults to http://localhost:3000), but set it in production.
CLIENT_URL=http://localhost:3000

# Stripe (Checkout + Webhook) — feature-specific: payment endpoints return 503 if unset.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ImgBB image upload — feature-specific: /api/upload/image returns 503 if unset.
IMGBB_API_KEY=your_imgbb_api_key

# Demo admin (used by npm run seed). Not needed to boot.
# npm run seed falls back to these documented defaults if the ADMIN_* vars are absent;
# npm run seed:admin REQUIRES ADMIN_EMAIL and ADMIN_PASSWORD to be set explicitly.
ADMIN_EMAIL=admin@mentorlagbe.com
# CHANGE IN PRODUCTION: Admin@12345 is only the documented demo default used by npm run seed.
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=MentorLagbe Admin
